-## Schema Conventions
-
-```python
-from pydantic import BaseModel, Field
-from typing import Optional, List, Dict, Any
-
-# Request body: suffix *In
-class MyResourceIn(BaseModel):
-    name: str = Field(..., description="资源名称")
-    config: Dict[str, Any] = Field(default_factory=dict, description="配置")
-
-# Partial update: suffix *UpdateIn, all fields Optional
-class MyResourceUpdateIn(BaseModel):
-    name: Optional[str] = Field(None, description="资源名称")
-    config: Optional[Dict[str, Any]] = Field(None, description="配置")
-
-# Response: suffix *Out, extends *In or standalone
-class MyResourceOut(MyResourceIn):
-    id: str = Field(..., description="唯一标识符")
-    created_at: str = ""
-    class Config:
-        from_attributes = True
-
-# Nested/composed: suffix *Schema
-class ParamSchema(BaseModel):
-    name: str = Field(..., description="参数名称")
-    value: Any = Field(None, description="参数值")
-```

-def _push_sys_path(path: Path) -> bool:
-    path_str = str(path)
-    if path_str in sys.path:
-        return False
-    sys.path.insert(0, path_str)
-    return True
-
-
-def _pop_sys_path(path: Path) -> None:
-    path_str = str(path)
-    while path_str in sys.path:
-        sys.path.remove(path_str)

{
  "code": "native-reviewed-suffix",
  "name": "Native Reviewed Suffix",
  "display_name_zh": "审核文本后缀",
  "description": "原生协议的可信样例。",
  "provider": "custom",
  "executor": "custom-native",
  "package": "dataforge-medical-demo-operators",
  "package_version": "0.1.0",
  "package_digest": "REPLACE_WITH_REGISTERED_WHEEL_SHA256",
  "implementation": "medical_demo_operators:NativeReviewedSuffix",
  "surfaces": [
    "advanced-canvas"
  ],
  "knowledge_types": [
    "text"
  ],
  "input_ports": {
    "input": {
      "artifact_type": "candidate:text",
      "cardinality": "one",
      "binding": "edge"
    }
  },
  "output_ports": {
    "output": {
      "artifact_type": "candidate:text",
      "cardinality": "many",
      "binding": "edge"
    }
  },
  "parameter_schema": {
    "type": "object",
    "properties": {
      "suffix": {
        "type": "string",
        "default": "（已审核）"
      },
      "delay_seconds": {
        "type": "number",
        "default": 0
      }
    },
    "additionalProperties": false
  },
  "parameter_docs": {
    "suffix": "追加文本。",
    "delay_seconds": "契约测试延迟。"
  },
  "capabilities": [
    "source-review-read"
  ],
  "timeout_seconds": 30,
  "input_example": {
    "input": [
      {
        "source_version_id": "v",
        "source_chunk_id": "c",
        "source_chunk_revision_id": "r",
        "source_review_snapshot_id": "review",
        "anchor_json": {
          "page": 1
        },
        "evidence_text": "高血压患者。",
        "source_knowledge_id": "k",
        "source_version_ids": [
          "v"
        ],
        "canonical_content": "正文",
        "data_json": {}
      }
    ]
  },
  "output_example": {
    "output": [
      {
        "source_knowledge_id": "k",
        "canonical_content": "正文（已审核）"
      }
    ]
  }
}
